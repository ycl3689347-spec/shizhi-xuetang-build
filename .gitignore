ios/*.xcodeproj/
ios/*.xcworkspace/
ios/build/
ios/Payload/
*.ipa

# ---- 题库 ----
# bank/src/*.json 是手写题库（要进版本库），_built.json 是 build.py 的中间产物
android/bank/_built.json

# ---- 截图 / 自检产物 ----
